// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CommercialUser {
  id                        String    @id @default(cuid())
  shop                      String
  name                      String
  email                     String?
  phone                     String?
  channel                   String?
  about                     String?
  captureCode               String    @unique
  personalCode              String    @unique
  status                    String    @default("active")
  passwordHash              String?
  passwordSalt              String?
  forceChange               Boolean   @default(false)
  failedAttempts            Int       @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  shopifyCustomerId         String?
  shopifyCaptureDiscountId  String?
  shopifyPersonalDiscountId String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  attributions CommercialCustomerAttribution[]
  commissions  Commission[]
  sessions     CommercialSession[]
}

model CommercialApplication {
  id            String    @id @default(cuid())
  shop          String
  name          String
  email         String
  phone         String?
  channel       String?
  about         String?
  inviterCode   String?
  passwordHash  String
  passwordSalt  String
  status        String    @default("pending")
  commercialId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  decidedAt     DateTime?

  @@unique([shop, email])
  @@index([shop, status])
}

model CommercialSession {
  id           String         @id @default(cuid())
  tokenHash    String         @unique
  commercialId String
  createdAt    DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())
  expiresAt    DateTime

  commercial CommercialUser @relation(fields: [commercialId], references: [id], onDelete: Cascade)

  @@index([commercialId, expiresAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  shop               String
  username           String
  displayName        String
  role               String    @default("admin")
  passwordHash       String
  passwordSalt       String
  enabled            Boolean   @default(true)
  forceChange        Boolean   @default(false)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  totalActiveSeconds Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions AdminSession[]

  @@unique([shop, username])
  @@index([shop, role])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model CommercialCustomerAttribution {
  id            String    @id @default(cuid())
  shop          String
  commercialId  String
  customerGid   String?
  customerEmail String?
  orderGid      String?
  sourceCode    String
  status        String    @default("active")
  firstOrderAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  commercial CommercialUser @relation(fields: [commercialId], references: [id])

  @@unique([shop, customerGid])
  @@index([shop, customerEmail])
}

model Commission {
  id             String    @id @default(cuid())
  shop           String
  commercialId   String
  orderGid       String
  orderName      String?
  basisCents     Int
  rateBps        Int
  amountCents    Int
  status         String    @default("pending_validation")
  validationDate DateTime?
  payoutId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commercial CommercialUser @relation(fields: [commercialId], references: [id])
  payout     Payout?        @relation(fields: [payoutId], references: [id])

  @@unique([shop, orderGid, commercialId])
}

model Payout {
  id         String    @id @default(cuid())
  shop       String
  label      String
  status     String    @default("draft")
  totalCents Int       @default(0)
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  commissions Commission[]
}

model B2BCompany {
  id             String   @id @default(cuid())
  shop           String
  companyName    String
  contactEmail   String?
  status         String   @default("pending")
  referredByCode String?
  commercialId   String?
  priceTier      String   @default("direct_60")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop, referredByCode])
}

model ChatThread {
  id        String   @id @default(cuid())
  shop      String
  subject   String
  channel   String
  ownerType String
  ownerId   String?
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  author    String
  body      String
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
}

model ArcadeRedemption {
  id                String    @id @default(cuid())
  shop              String
  customerGid       String?
  email             String?
  keysSpent         Int
  discountPercent   Int
  code              String    @unique
  shopifyDiscountId String?
  status            String    @default("issued")
  createdAt         DateTime  @default(now())
  redeemedAt        DateTime?
}

model ArcadeDiscountCode {
  id                 String    @id @default(cuid())
  shop               String
  code               String    @unique
  discountPercent    Int
  status             String    @default("available")
  source             String    @default("precreated")
  assignedToEmail    String?
  assignedCustomerId String?
  assignedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([shop, discountPercent, status])
}

model DiscountIssuance {
  id                String   @id @default(cuid())
  shop              String
  code              String   @unique
  kind              String
  ownerType         String?
  ownerId           String?
  percent           Int
  usageLimit        Int?
  combinesWithJson  String?
  shopifyDiscountId String?
  status            String   @default("created")
  createdAt         DateTime @default(now())
}

model ProcessedWebhook {
  id          String   @id
  shop        String
  topic       String
  payloadJson String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  shop        String
  actor       String?
  action      String
  targetType  String?
  targetId    String?
  detailsJson String?
  createdAt   DateTime @default(now())
}

model ContactRequest {
  id        String   @id @default(cuid())
  shop      String
  email     String?
  name      String?
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}


model LffFamily {
  id            String   @id @default(cuid())
  shop          String
  familyKey     String
  category      String
  name          String
  sortOrder     Int      @default(999)
  enabled       Boolean  @default(true)
  isCustom      Boolean  @default(false)
  aliasesJson   String?
  logoFileId    String?
  logoUrl       String?
  motionFileId  String?
  motionUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, familyKey])
  @@index([shop, category, sortOrder])
}


model ArcadeSession {
  id          String   @id @default(cuid())
  shop        String
  sessionKey  String
  game        String
  customerId  String?
  visitorId   String?
  playerLabel String?
  startedAt   DateTime
  endedAt     DateTime?
  seconds     Int?
  result      String   @default("started")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, sessionKey])
  @@index([shop, startedAt])
  @@index([shop, game, startedAt])
  @@index([shop, customerId])
  @@index([shop, visitorId])
}
