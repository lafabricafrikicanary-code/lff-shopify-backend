// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CommercialUser {
  id                        String    @id @default(cuid())
  shop                      String
  name                      String
  email                     String?
  phone                     String?
  channel                   String?
  about                     String?
  kind                      String    @default("commercial")
  brandName                 String?
  promoPercent              Int       @default(15)
  firstSaleRateBps          Int       @default(3000)
  referralRateBps           Int       @default(1000)
  ownProductRateBps         Int       @default(0)
  captureCode               String    @unique
  personalCode              String    @unique
  status                    String    @default("active")
  passwordHash              String?
  passwordSalt              String?
  forceChange               Boolean   @default(false)
  failedAttempts            Int       @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  shopifyCustomerId         String?
  shopifyCaptureDiscountId  String?
  shopifyPersonalDiscountId String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  attributions    CommercialCustomerAttribution[]
  commissions     Commission[]
  sessions        CommercialSession[]
  creatorFamilies LffFamily[] @relation("CreatorFamilies")
  creatorProducts CreatorProduct[]
  ownPurchases    CommercialOwnPurchase[]
}

model CommercialApplication {
  id            String    @id @default(cuid())
  shop          String
  name          String
  email         String
  phone         String?
  channel       String?
  about         String?
  kind          String    @default("commercial")
  brandName     String?
  promoPercent  Int       @default(15)
  inviterCode   String?
  passwordHash  String
  passwordSalt  String
  status        String    @default("pending")
  commercialId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  decidedAt     DateTime?

  @@unique([shop, email])
  @@index([shop, status])
}

model CommercialSession {
  id           String         @id @default(cuid())
  tokenHash    String         @unique
  commercialId String
  createdAt    DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())
  expiresAt    DateTime

  commercial CommercialUser @relation(fields: [commercialId], references: [id], onDelete: Cascade)

  @@index([commercialId, expiresAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  shop               String
  username           String
  displayName        String
  role               String    @default("admin")
  passwordHash       String
  passwordSalt       String
  enabled            Boolean   @default(true)
  forceChange        Boolean   @default(false)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  totalActiveSeconds Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions AdminSession[]

  @@unique([shop, username])
  @@index([shop, role])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model CommercialCustomerAttribution {
  id            String    @id @default(cuid())
  shop          String
  commercialId  String
  customerGid   String?
  customerEmail String?
  orderGid      String?
  sourceCode    String
  status        String    @default("active")
  firstOrderAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  commercial CommercialUser @relation(fields: [commercialId], references: [id])

  @@unique([shop, customerGid])
  @@index([shop, customerEmail])
}

model Commission {
  id             String    @id @default(cuid())
  shop           String
  commercialId   String
  orderGid       String
  orderName      String?
  basisCents     Int
  rateBps        Int
  amountCents    Int
  commissionType String    @default("commercial")
  detailsJson    String?
  status         String    @default("pending_validation")
  validationDate DateTime?
  payoutId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commercial CommercialUser @relation(fields: [commercialId], references: [id])
  payout     Payout?        @relation(fields: [payoutId], references: [id])

  @@unique([shop, orderGid, commercialId])
}

model Payout {
  id           String    @id @default(cuid())
  shop         String
  commercialId String?
  label        String
  status       String    @default("draft")
  totalCents   Int       @default(0)
  method       String?
  reference    String?
  notes        String?
  paidBy       String?
  createdAt    DateTime  @default(now())
  paidAt       DateTime?
  updatedAt    DateTime  @updatedAt

  commissions Commission[]

  @@index([shop, commercialId, status])
}

model B2BCompany {
  id                String    @id @default(cuid())
  shop              String
  companyName       String
  contactName       String?
  contactEmail      String?
  phone             String?
  taxId             String?
  website           String?
  status            String    @default("pending")
  referredByCode    String?
  commercialId      String?
  priceTier         String    @default("direct_60")
  passwordHash      String?
  passwordSalt      String?
  forceChange       Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  shopifyCustomerId String?
  firstOrderUsed    Boolean   @default(false)
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions B2BSession[]
  orders   B2BOrder[]

  @@index([shop, referredByCode])
  @@index([shop, contactEmail])
  @@index([shop, status])
}


model B2BOrder {
  id             String    @id @default(cuid())
  shop           String
  companyId      String
  commercialId   String?
  orderGid       String
  orderName      String?
  subtotalCents  Int       @default(0)
  totalCents     Int       @default(0)
  currency       String?
  status         String    @default("paid")
  paidAt         DateTime?
  cancelledAt    DateTime?
  refundedCents  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company B2BCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([shop, orderGid, companyId])
  @@index([shop, companyId, createdAt])
  @@index([shop, commercialId, createdAt])
}

model ChatThread {
  id        String   @id @default(cuid())
  shop      String
  subject   String
  channel   String
  ownerType String
  ownerId   String?
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  author    String
  body      String
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
}

model ArcadeRedemption {
  id                String    @id @default(cuid())
  shop              String
  customerGid       String?
  email             String?
  keysSpent         Int
  discountPercent   Int
  code              String    @unique
  shopifyDiscountId String?
  status            String    @default("issued")
  createdAt         DateTime  @default(now())
  redeemedAt        DateTime?
}

model ArcadeDiscountCode {
  id                 String    @id @default(cuid())
  shop               String
  code               String    @unique
  discountPercent    Int
  status             String    @default("available")
  source             String    @default("precreated")
  assignedToEmail    String?
  assignedCustomerId String?
  assignedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([shop, discountPercent, status])
}

model DiscountIssuance {
  id                String   @id @default(cuid())
  shop              String
  code              String   @unique
  kind              String
  ownerType         String?
  ownerId           String?
  percent           Int
  usageLimit        Int?
  combinesWithJson  String?
  shopifyDiscountId String?
  status            String   @default("created")
  createdAt         DateTime @default(now())
}

model ProcessedWebhook {
  id          String   @id
  shop        String
  topic       String
  payloadJson String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  shop        String
  actor       String?
  action      String
  targetType  String?
  targetId    String?
  detailsJson String?
  createdAt   DateTime @default(now())
}

model ContactRequest {
  id        String   @id @default(cuid())
  shop      String
  email     String?
  name      String?
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}


model LffFamily {
  id            String   @id @default(cuid())
  shop          String
  familyKey     String
  category      String
  name          String
  sortOrder     Int      @default(999)
  enabled       Boolean  @default(true)
  isCustom      Boolean  @default(false)
  aliasesJson   String?
  logoFileId    String?
  logoUrl       String?
  motionFileId  String?
  motionUrl     String?
  creatorId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator CommercialUser? @relation("CreatorFamilies", fields: [creatorId], references: [id], onDelete: SetNull)

  @@unique([shop, familyKey])
  @@index([shop, category, sortOrder])
  @@index([shop, creatorId])
}



model LffCategory {
  id        String   @id @default(cuid())
  shop      String
  categoryKey String
  name      String
  sortOrder Int      @default(999)
  state     String   @default("published")
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, categoryKey])
  @@unique([shop, name])
  @@index([shop, state, sortOrder])
}

model CreatorProduct {
  id          String   @id @default(cuid())
  shop        String
  creatorId   String
  productGid  String
  productHandle String?
  familyKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator CommercialUser @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([shop, productGid])
  @@index([shop, creatorId])
  @@index([shop, familyKey])
}

model CommercialOwnPurchase {
  id           String   @id @default(cuid())
  shop         String
  commercialId String
  orderGid     String
  orderName    String?
  totalCents   Int      @default(0)
  currency     String?
  code         String
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  commercial CommercialUser @relation(fields: [commercialId], references: [id], onDelete: Cascade)

  @@unique([shop, orderGid, commercialId])
  @@index([shop, commercialId, createdAt])
}

model TrafficPresence {
  id             String   @id @default(cuid())
  shop           String
  visitorId      String
  sessionKey     String?
  customerId     String?
  source         String   @default("web")
  sourceDetail   String?
  commercialCode String?
  companyId      String?
  path           String?
  referrer       String?
  ipHash         String?
  countryCode    String?
  country        String?
  region         String?
  city           String?
  latitude       Float?
  longitude      Float?
  userAgent      String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, visitorId])
  @@index([shop, lastSeenAt])
  @@index([shop, source, lastSeenAt])
  @@index([shop, ipHash])
}

model ArcadeSession {
  id          String   @id @default(cuid())
  shop        String
  sessionKey  String
  game        String
  customerId  String?
  visitorId   String?
  playerLabel String?
  startedAt   DateTime
  endedAt     DateTime?
  seconds     Int?
  result      String   @default("started")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, sessionKey])
  @@index([shop, startedAt])
  @@index([shop, game, startedAt])
  @@index([shop, customerId])
  @@index([shop, visitorId])
}


model CustomerAccount {
  id                String    @id @default(cuid())
  shop              String
  email             String
  name              String
  phone             String?
  passwordHash      String
  passwordSalt      String
  status            String    @default("active")
  marketingConsent  Boolean   @default(false)
  forceChange       Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  shopifyCustomerId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          CustomerSession[]
  clubProfile       ClubProfile?
  boxSubscriptions  BoxSubscription[]

  @@unique([shop, email])
  @@index([shop, status])
  @@index([shop, shopifyCustomerId])
}

model CustomerSession {
  id           String          @id @default(cuid())
  tokenHash    String          @unique
  customerId   String
  createdAt    DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())
  expiresAt    DateTime

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model ClubProfile {
  id               String          @id @default(cuid())
  shop             String
  customerId       String          @unique
  name             String
  email            String
  phone            String?
  marketingConsent Boolean         @default(true)
  joinedAt         DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shop, email])
}

model BoxSubscription {
  id                     String          @id @default(cuid())
  shop                   String
  customerId             String?
  email                  String
  name                   String
  phone                  String?
  address                String?
  postal                 String?
  city                   String?
  country                String?
  status                 String          @default("pending_payment")
  monthlyPriceCents      Int             @default(1500)
  monthlyVoucherCents    Int             @default(1500)
  provider               String?
  providerSubscriptionId String?
  startedAt              DateTime?
  nextRenewalAt          DateTime?
  nextBoxAt              DateTime?
  pausedAt               DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  customer CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vouchers BoxVoucher[]

  @@index([shop, email, status])
  @@index([customerId, status])
}

model BoxVoucher {
  id                String          @id @default(cuid())
  shop              String
  subscriptionId    String
  code              String          @unique
  amountCents       Int             @default(1500)
  status            String          @default("prepared")
  shopifyDiscountId String?
  createdAt         DateTime        @default(now())
  redeemedAt        DateTime?
  expiresAt         DateTime?

  subscription BoxSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([shop, status])
}

model Favorite {
  id               String    @id @default(cuid())
  shop             String
  identityKey      String
  visitorId        String?
  customerId       String?
  customerEmail    String?
  productGid       String
  productHandle    String?
  productTitle     String?
  productImage     String?
  status           String    @default("active")
  firstFavoritedAt DateTime  @default(now())
  lastFavoritedAt  DateTime  @default(now())
  removedAt        DateTime?
  purchasedAt      DateTime?
  orderGid         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign RetentionCampaign?

  @@unique([shop, identityKey, productGid])
  @@index([shop, customerId, productGid])
  @@index([shop, customerEmail, productGid])
  @@index([shop, status, lastFavoritedAt])
}

model RetentionCampaign {
  id                String    @id @default(cuid())
  shop              String
  favoriteId        String    @unique
  productGid        String
  customerId        String?
  customerEmail     String?
  percent           Int       @default(20)
  status            String    @default("waiting")
  code              String?   @unique
  shopifyDiscountId String?
  eligibleAt        DateTime
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  issuedAt          DateTime?
  sentAt            DateTime?
  redeemedAt        DateTime?
  purchasedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  favorite Favorite @relation(fields: [favoriteId], references: [id], onDelete: Cascade)

  @@index([shop, status, eligibleAt])
  @@index([shop, customerEmail])
}

model ProductReview {
  id            String    @id @default(cuid())
  shop          String
  productGid    String?
  productHandle String?
  productTitle  String?
  category      String?
  name          String
  orderRef      String?
  rating        Int
  body          String
  imageFileId   String?
  imageUrl      String?
  source        String    @default("customer_web")
  status        String    @default("pending")
  hidden        Boolean   @default(false)
  registeredBy  String?
  moderatedBy   String?
  moderatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, productGid, status, hidden])
  @@index([shop, productHandle, status, hidden])
  @@index([shop, status, createdAt])
}

model Expense {
  id            String    @id @default(cuid())
  shop          String
  concept       String
  amountCents   Int
  category      String
  expenseDate   DateTime
  paymentMethod String?
  reference     String?
  notes         String?
  receiptFileId String?
  receiptUrl    String?
  receiptName   String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([shop, expenseDate])
  @@index([shop, category])
}

model AccessRecoveryRequest {
  id          String    @id @default(cuid())
  shop        String
  accountType String
  accountId   String?
  email       String
  status      String    @default("pending")
  source      String    @default("self_service")
  createdAt   DateTime  @default(now())
  handledAt   DateTime?
  handledBy   String?
  notes       String?

  @@index([shop, accountType, status])
  @@index([shop, email])
}

model B2BSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  companyId  String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  company B2BCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
}

model TrafficEvent {
  id             String    @id @default(cuid())
  shop           String
  visitorId      String?
  customerId     String?
  sessionKey     String?
  event          String    @default("page_view")
  source         String    @default("web")
  sourceDetail   String?
  path           String?
  referrer       String?
  campaign       String?
  medium         String?
  content        String?
  term           String?
  commercialCode String?
  companyId      String?
  metadataJson   String?
  createdAt      DateTime  @default(now())

  @@index([shop, createdAt])
  @@index([shop, source, createdAt])
  @@index([shop, event, createdAt])
}

model OutboundMessage {
  id          String    @id @default(cuid())
  shop        String
  channel     String
  recipient   String
  template    String
  payloadJson String?
  relatedType String?
  relatedId   String?
  status      String    @default("pending_provider")
  provider    String?
  providerId  String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?

  @@index([shop, status, channel])
  @@index([shop, relatedType, relatedId])
}
